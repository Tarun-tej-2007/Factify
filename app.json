{
  "expo": {
    "name": "Factify",
    "slug": "factify",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "factify",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kishore1215.factify"
    },
    "android": {
      "package": "com.kishore1215.factify",
      "icon": "./assets/images/icon.png"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "expo-router": {
        "appRoot": "app"
      },
      "eas": {
        "projectId": "569ee1ab-7e8f-442a-9863-b70ae08bae26"
      }
    }
  }
}
